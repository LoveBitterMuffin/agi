{
  "agi": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/validate-tool-call.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/validate-tool-call.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/harness-post-tool.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/reset-tool-chain.mjs",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/reset-tool-chain.mjs",
        "timeout": 10
      }
    ]
  }
}
